<script>
var IMGS={p1:"{{ 'blue-set-img-00.jpg' | asset_url }}",p2:"{{ 'blue-set-img-01.jpg' | asset_url }}",p3:"{{ 'blue-set-img-02.jpg' | asset_url }}",p4:"{{ 'blue-set-img-03.jpg' | asset_url }}",p5:"{{ 'blue-set-img-04.jpg' | asset_url }}"};
window.IMGS=IMGS;
(function(){
  var KEYS=['p1','p2','p3','p4','p5'],total=KEYS.length,current=0;
  var mainImg=document.getElementById('mainImg'),counter=document.getElementById('galleryCounter'),thumbsCol=document.querySelector('.thumbs-col');
  function goTo(idx){idx=((idx%total)+total)%total;current=idx;mainImg.style.transition='opacity .18s ease';mainImg.style.opacity='0';setTimeout(function(){mainImg.src=window.IMGS[KEYS[idx]];mainImg.style.opacity='1';},140);document.querySelectorAll('.thumb').forEach(function(t,i){t.classList.toggle('active',i===idx);if(i===idx&&thumbsCol)t.scrollIntoView({behavior:'smooth',block:'nearest'});});if(counter)counter.textContent=(idx+1)+' / '+total;}
  document.querySelectorAll('.thumb').forEach(function(th,i){th.addEventListener('click',function(e){e.stopImmediatePropagation();goTo(i);});});
  var btnPrev=document.getElementById('galleryPrev'),btnNext=document.getElementById('galleryNext');
  if(btnPrev)btnPrev.addEventListener('click',function(){goTo(current-1);});
  if(btnNext)btnNext.addEventListener('click',function(){goTo(current+1);});
  document.addEventListener('keydown',function(e){if(e.key==='ArrowLeft')goTo(current-1);if(e.key==='ArrowRight')goTo(current+1);});
  var tx=0,mainView=document.querySelector('.main-view');
  if(mainView){mainView.addEventListener('touchstart',function(e){tx=e.touches[0].clientX;},{passive:true});mainView.addEventListener('touchend',function(e){var dx=e.changedTouches[0].clientX-tx;if(Math.abs(dx)>45)goTo(dx<0?current+1:current-1);},{passive:true});}
  if(counter)counter.textContent='1 / '+total;
})();
function toggleAcc(id){var body=document.getElementById(id),trigger=body.previousElementSibling;body.classList.toggle('open');trigger.classList.toggle('open');}
function cartGo(){var t=document.getElementById('toast');if(t){t.classList.add('show');setTimeout(function(){t.classList.remove('show');},1500);}}
function switchTab(el,key){document.querySelectorAll('.type-tab').forEach(function(t){t.classList.remove('active');});el.classList.add('active');var p={tshirt:['29.95 CHF','Ice Blue T-Shirt'],short:['25.95 CHF','Ice Blue Short'],set:['55.90 CHF','Ice Blue Set']};var pm=document.getElementById('priceMain'),pl=document.getElementById('priceLabel');if(pm)pm.textContent=p[key][0];if(pl)pl.textContent=p[key][1];}
(function(){
  var SIZES=['XS','S','M','L','XL'],ans=[],finalSize='M';
  var SD={cols:['Taille','Largeur','Longueur','Épaule'],rows:[['XS','61 cm','66 cm','20 cm'],['S','62 cm','68 cm','21 cm'],['M','64 cm','70 cm','22 cm'],['L','65 cm','71 cm','23.7 cm'],['XL','68 cm','72.5 cm','25 cm']]};
  window.sqOpen=function(){sqReset();document.getElementById('sqOverlay').classList.add('open');document.body.style.overflow='hidden';};
  window.sqClose=function(){document.getElementById('sqOverlay').classList.remove('open');document.body.style.overflow='';};
  window.sqCloseOutside=function(e){if(e.target===document.getElementById('sqOverlay'))window.sqClose();};
  window.sqAnswer=function(step,val){ans[step-1]=val;event.currentTarget.parentElement.querySelectorAll('.sq-opt').forEach(function(o){o.classList.remove('selected');});event.currentTarget.classList.add('selected');setTimeout(function(){if(step<3){document.getElementById('sqStep'+step).style.display='none';document.getElementById('sqStep'+(step+1)).style.display='block';upProg(step+1);}else{compute();}},280);};
  function upProg(a){['sqp1','sqp2','sqp3'].forEach(function(id,i){document.getElementById(id).className='sq-step'+(i+1<a?' done':i+1===a?' active':'');});}
  function compute(){var score=(ans[0]||0)+(ans[1]||0)+(ans[2]||0),idx=Math.round(Math.min(Math.max(score/2,0),4));finalSize=SIZES[idx];document.getElementById('sqFinalSize').textContent=finalSize;document.getElementById('sqDesc').textContent='La taille '+finalSize+' est recommandée.';var h='<table class="sq-table"><thead><tr>';SD.cols.forEach(function(c){h+='<th>'+c+'</th>';});h+='</tr></thead><tbody>';SD.rows.forEach(function(row){var hl=row[0]===finalSize?' class="hl"':'';h+='<tr'+hl+'>';row.forEach(function(c){h+='<td>'+c+'</td>';});h+='</tr>';});h+='</tbody></table>';document.getElementById('sqTableWrap').innerHTML=h;['sqStep1','sqStep2','sqStep3'].forEach(function(id){document.getElementById(id).style.display='none';});document.getElementById('sqResult').style.display='block';upProg(4);}
  window.sqApply=function(){window.sqClose();};
  window.sqReset=function(){ans=[];['sqStep1','sqStep2','sqStep3'].forEach(function(id,i){document.getElementById(id).style.display=i===0?'block':'none';document.querySelectorAll('#'+id+' .sq-opt').forEach(function(o){o.classList.remove('selected');});});document.getElementById('sqResult').style.display='none';upProg(1);};
})();
</script>

