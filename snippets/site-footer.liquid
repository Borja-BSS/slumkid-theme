<style>
/* ── SITE FOOTER ── */
footer.site-footer { background: #f5f5f7; border-top: 1px solid rgba(0,0,0,0.07); }
footer.site-footer .foot-insta { padding: 2.8rem 2rem 0; }
footer.site-footer .foot-insta-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.2rem; padding: 0 0.2rem; }
footer.site-footer .foot-insta-handle { font-size: 1rem; font-weight: 800; letter-spacing: 0.01em; color: #0a0a0a; text-decoration: none; text-transform: uppercase; transition: opacity 0.2s; }
footer.site-footer .foot-insta-handle:hover { opacity: 0.7; }
footer.site-footer .foot-follow { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.15em; color: #0a0a0a; text-transform: uppercase; text-decoration: none; border-bottom: 1px solid rgba(0,0,0,0.4); padding-bottom: 1px; }
footer.site-footer .foot-follow:hover { border-color: #0a0a0a; }
footer.site-footer .foot-feed-wrap { position: relative; overflow: hidden; }
footer.site-footer .foot-feed { display: flex; gap: 6px; overflow-x: auto; scroll-behavior: smooth; scrollbar-width: none; padding-bottom: 4px; cursor: grab; user-select: none; }
footer.site-footer .foot-feed.is-dragging { cursor: grabbing; scroll-behavior: auto; }
footer.site-footer .foot-feed::-webkit-scrollbar { display: none; }
footer.site-footer .foot-feed-item { flex: 0 0 140px; height: 140px; background: #ddd; overflow: hidden; cursor: pointer; transition: opacity 0.25s; border-radius: 2px; }
footer.site-footer .foot-feed-item:hover { opacity: 0.8; }
footer.site-footer .foot-feed-item img { width: 100%; height: 100%; object-fit: cover; display: block; }
footer.site-footer .foot-newsletter { text-align: center; padding: 3rem 2rem 2rem; border-bottom: 1px solid rgba(0,0,0,0.07); }
footer.site-footer .foot-nl-title { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.15em; color: #0a0a0a; text-transform: uppercase; margin-bottom: 1.4rem; }
footer.site-footer .foot-nl-form { display: flex; align-items: center; justify-content: center; gap: 0; max-width: 440px; margin: 0 auto 1.8rem; border-bottom: 1px solid rgba(0,0,0,0.35); }
footer.site-footer .foot-nl-input { flex: 1; background: transparent; border: none; outline: none; font-family: inherit; font-size: 16px; color: #0a0a0a; padding: 0.6rem 0.8rem 0.6rem 0; letter-spacing: 0.02em; }
footer.site-footer .foot-nl-input::placeholder { color: rgba(0,0,0,0.35); }
footer.site-footer .foot-nl-btn { background: transparent; border: none; cursor: pointer; font-family: inherit; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.15em; text-transform: uppercase; color: #0a0a0a; padding: 0.6rem 0; white-space: nowrap; transition: opacity 0.2s; }
footer.site-footer .foot-nl-btn:hover { opacity: 0.6; }
footer.site-footer .foot-socials { display: flex; align-items: center; justify-content: center; gap: 1.6rem; }
footer.site-footer .foot-social-icon { color: #0a0a0a; opacity: 0.75; transition: opacity 0.2s; text-decoration: none; display: flex; }
footer.site-footer .foot-social-icon:hover { opacity: 1; }
footer.site-footer .foot-legal { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; padding: 1.4rem 2rem; }
footer.site-footer .foot-copy { font-size: 0.62rem; color: rgba(0,0,0,0.5); letter-spacing: 0.02em; white-space: normal; word-break: break-word; text-align: center; }
footer.site-footer .foot-legal-links { display: flex; flex-wrap: wrap; gap: 1.4rem; align-items: center; justify-content: center; }
footer.site-footer .foot-legal-links a { font-size: 0.68rem; color: rgba(0,0,0,0.55); text-decoration: none; letter-spacing: 0.04em; transition: color 0.2s; }
footer.site-footer .foot-legal-links a:hover { color: #0a0a0a; }
@media (max-width: 768px) {
  footer.site-footer .foot-feed-item { flex: 0 0 100px; height: 100px; }
  footer.site-footer .foot-legal { flex-direction: column; text-align: center; }
  footer.site-footer .foot-legal-links { justify-content: center; }
}
</style>

