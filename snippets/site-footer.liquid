<script>
(function() {
  var feed = document.getElementById('footFeed');
  if (!feed) return;
  var isDragging = false, startX = 0, scrollStart = 0;
  feed.addEventListener('mousedown', function(e) {
    isDragging = true; startX = e.pageX; scrollStart = feed.scrollLeft;
    feed.classList.add('is-dragging');
  });
  document.addEventListener('mousemove', function(e) {
    if (!isDragging) return;
    feed.scrollLeft = scrollStart - (e.pageX - startX);
  });
  document.addEventListener('mouseup', function() {
    isDragging = false; feed.classList.remove('is-dragging');
  });
  feed.addEventListener('click', function(e) { if (isDragging) e.preventDefault(); });
})();
</script>
